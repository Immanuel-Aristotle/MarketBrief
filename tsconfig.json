{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		},
		"types": [
			"$app/types",
			"vite/client",
			"./worker-configuration.d.ts"
		]
	},
	"include": ["src", "vite.config.ts"],
	"exclude": [".svelte-kit/output"]
}
